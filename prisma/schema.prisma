generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  owner
  admin
  rider
  customer
}

enum UserStatus {
  pending
  verified
  active
  inactive
}

enum BusinessStatus {
  draft
  pending_review
  approved
  rejected
  suspended
}

enum DocumentType {
  tax_id
  food_certificate
  owner_id
  bank_document
  business_license
}

enum OrderStatus {
  pending
  preparing
  ready
  out_for_delivery
  delivered
  cancelled
}

model User {
  id                Int                 @id @default(autoincrement())
  firstName         String
  lastName          String
  email             String              @unique
  phone             String              @unique
  password          String
  role              Role                @default(owner)
  phoneVerified     Boolean             @default(false)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  status            UserStatus          @default(pending)
  
  businesses        Business[]
  phoneVerifications PhoneVerification[]
  orders            Order[]
  threads           Thread[]            @relation("ThreadParticipants")
  sentMessages      Message[]           @relation("MessageSender")
  riderProfile      RiderProfile?
  riderOrders       Order[]             @relation("RiderOrders")
  
  // ── TRACKS RIDER SHIFTS & LIVE GPS ──
  shiftLogs         ShiftLog[]
}

model PhoneVerification {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  code      String
  expiresAt DateTime
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Business {
  id              Int            @id @default(autoincrement())
  ownerId         Int
  owner           User           @relation(fields: [ownerId], references: [id])
  name            String
  type            String
  streetAddress   String
  city            String
  state           String
  zipCode         String
  businessPhone   String
  businessEmail   String
  websiteUrl      String?
  description     String?
  status          BusinessStatus @default(draft)
  rejectionReason String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  // Settings: images
  thumbnailUrl  String?   
  profilePicUrl String?  

  galleryImages   BusinessImage[]
  promos          Promo[]
  country         String?

  // Settings: operating hours
  openingHour   String?   
  closingHour   String?   

  // Settings: delivery config
  deliveryRadius  Float?  
  minimumOrder    Float?  
  deliveryFee     Float?  

  // Settings: notification preferences
  notifNewOrders    Boolean @default(true)
  notifOrderUpdates Boolean @default(true)
  notifSystemAlerts Boolean @default(true)
  notifPromotions   Boolean @default(false)

  // ── NEW: GEOLOCATION FOR PROXIMITY MATCHING ──
  latitude        Float?
  longitude       Float?

  documents    BusinessDocument[]
  bankDetail   BusinessBankDetail?
  menuItems    MenuItem[]
  staffMembers StaffMember[]
  orders       Order[]
}

// ── NEW: TRACKS IF RIDER IS ONLINE + CURRENT GPS COORDINATES ──
model ShiftLog {
  id         Int       @id @default(autoincrement())
  
  // Make userId optional (?) temporarily so existing rows don't break
  userId     Int?      @unique 
  user       User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  isOnline   Boolean   @default(false)
  latitude   Float?
  longitude  Float?
  
  // Provide a default value for existing rows so PostgreSQL can populate them
  updatedAt  DateTime  @default(now()) @updatedAt

  @@index([userId])
}

model BusinessDocument {
  id         Int          @id @default(autoincrement())
  businessId Int
  business   Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  type       DocumentType
  url        String
  fileName   String
  verified   Boolean      @default(false)
  createdAt  DateTime     @default(now())
}

model BusinessBankDetail {
  id            Int      @id @default(autoincrement())
  businessId    Int      @unique
  business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  bankName      String
  accountName   String
  accountNumber String
  routingNumber String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model MenuItem {
  id              Int      @id @default(autoincrement())
  businessId      Int
  business        Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name            String
  category        String
  price           Float
  description     String?
  imageUrl        String?
  imagePublicId   String?
  available       Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  orderItems      OrderItem[]

  @@index([businessId])
}

model BusinessImage {
  id         Int      @id @default(autoincrement())
  businessId Int
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  imageUrl   String   
  createdAt  DateTime @default(now())

  @@index([businessId])
}

model StaffMember {
  id         Int      @id @default(autoincrement())
  businessId Int
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  fullName   String
  role       String
  email      String?
  phone      String?
  status     String   @default("Active")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([businessId])
}

model Order {
  id               Int         @id @default(autoincrement())
  businessId       Int
  business         Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customerId       Int?
  customer         User?       @relation(fields: [customerId], references: [id])
  customerName     String
  customerPhone    String?
  address          String?
  paymentMethod    String?
  notes            String?
  paymentStatus    String?   
  paymentReference String?   
  paymentChannel   String?   
  paidAt           DateTime?
  status           OrderStatus @default(pending)
  total            Float
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  items            OrderItem[]
  riderId          Int?        
  rider            User?       @relation("RiderOrders", fields: [riderId], references: [id])
  payout           Float?      

  @@index([businessId])
  @@index([customerId])
  @@index([riderId])        
}

model OrderItem {
  id         Int       @id @default(autoincrement())
  orderId    Int
  order      Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId Int?
  menuItem   MenuItem? @relation(fields: [menuItemId], references: [id])
  name       String
  price      Float
  quantity   Int       @default(1)
  createdAt  DateTime  @default(now())

  @@index([orderId])
  @@index([menuItemId])
}

model Thread {
  id           String    @id @default(uuid())
  type         String    
  subject      String
  status       String    @default("open") 
  participants User[]    @relation("ThreadParticipants")
  messages     Message[]
  lastMessage  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Message {
  id         String   @id @default(uuid())
  threadId   String
  thread     Thread   @relation(fields: [threadId], references: [id], onDelete: Cascade)
  senderId   Int
  sender     User     @relation("MessageSender", fields: [senderId], references: [id])
  senderRole String
  content    String
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())
  
  @@index([threadId])
  @@index([senderId])
}

model RiderProfile {
  id            Int      @id @default(autoincrement())
  userId        Int      @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicleType   String
  plateNumber   String?
  idDocumentUrl String
  isVerified    Boolean  @default(false)
  createdAt     DateTime @default(now())
}

// Placeholder for missing reference in your initial schema snippet
model Promo {
  id         Int      @id @default(autoincrement())
  businessId Int
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  
  // Make these optional (?) so your 3 existing rows can stay blank/null
  code       String?
  discount   Float?
}
