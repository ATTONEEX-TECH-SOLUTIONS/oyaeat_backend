generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  owner
  admin
  rider
  customer
}

enum UserStatus {
  pending
  verified
  active
  inactive
}

enum BusinessStatus {
  draft
  pending_review
  approved
  rejected
  suspended
}

enum DocumentType {
  tax_id
  food_certificate
  owner_id
  bank_document
  business_license
}

enum OrderStatus {
  pending
  preparing
  ready
  out_for_delivery
  delivered
  cancelled
}

model User {
  id            Int      @id @default(autoincrement())
  firstName     String
  lastName      String
  email         String   @unique
  phone         String   @unique
  password      String
  role          Role     @default(owner)
  phoneVerified Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  status        UserStatus  @default(pending)

  businesses         Business[]
  phoneVerifications PhoneVerification[]
  orders             Order[]
  threads            Thread[]  @relation("ThreadParticipants")
  sentMessages       Message[] @relation("MessageSender")
  riderProfile       RiderProfile?

  // ── ADD THIS NEW LINE ──────────────────────────────────
  riderOrders        Order[]           @relation("RiderOrders")
  shiftLogs          ShiftLog[]        // Links to the new shift tracker below
}

model PhoneVerification {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  code      String
  expiresAt DateTime
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Business {
  id              Int            @id @default(autoincrement())
  ownerId         Int
  owner           User           @relation(fields: [ownerId], references: [id])
  name            String
  type            String
  streetAddress   String
  city            String
  state           String
  zipCode         String
  businessPhone   String
  businessEmail   String
  websiteUrl      String?
  description     String?
  status          BusinessStatus @default(draft)
  rejectionReason String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  // ── Settings: images ──────────────────────────────────────
  thumbnailUrl  String?   // restaurant banner / cover photo
  profilePicUrl String?  // restaurant logo / avatar

  galleryImages   BusinessImage[]
  promos       Promo[]
  // ── Settings: location extras ────────────────────────────
  country       String?

  // ── Settings: operating hours ────────────────────────────
  openingHour   String?   // e.g. "10:00"
  closingHour   String?   // e.g. "23:00"

  // ── Settings: delivery config ────────────────────────────
  deliveryRadius  Float?  // in km
  minimumOrder    Float?  // minimum order value
  deliveryFee     Float?  // flat delivery fee

  // ── Settings: notification preferences ──────────────────
  notifNewOrders    Boolean @default(true)
  notifOrderUpdates Boolean @default(true)
  notifSystemAlerts Boolean @default(true)
  notifPromotions   Boolean @default(false)

  documents    BusinessDocument[]
  bankDetail   BusinessBankDetail?
  menuItems    MenuItem[]
  staffMembers StaffMember[]
  orders       Order[]
}

model BusinessDocument {
  id         Int          @id @default(autoincrement())
  businessId Int
  business   Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  type       DocumentType
  url        String
  fileName   String
  verified   Boolean      @default(false)
  createdAt  DateTime     @default(now())
}

model BusinessBankDetail {
  id            Int      @id @default(autoincrement())
  businessId    Int      @unique
  business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  bankName      String
  accountName   String
  accountNumber String
  routingNumber String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model MenuItem {
  id              Int      @id @default(autoincrement())
  businessId      Int
  business        Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name            String
  category        String
  price           Float
  description     String?
  imageUrl        String?
  imagePublicId   String?
  available       Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  orderItems      OrderItem[]

  @@index([businessId])
}


model BusinessImage {
  id         Int      @id @default(autoincrement())
  businessId Int
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  imageUrl   String   // The real, non-nullable path to the uploaded file
  createdAt  DateTime @default(now())

  @@index([businessId])
}

model StaffMember {
  id         Int      @id @default(autoincrement())
  businessId Int
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  fullName   String
  role       String
  email      String?
  phone      String?
  status     String   @default("Active")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([businessId])
}

model Order {
  id            Int         @id @default(autoincrement())
  businessId    Int
  business      Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customerId    Int?
  customer      User?       @relation(fields: [customerId], references: [id])
  customerName  String
  customerPhone String?
  address       String?
  paymentMethod String?
  notes         String?

 
  paymentStatus    String?   // "pending" | "paid" | "failed"
  paymentReference String?   // Paystack reference
  paymentChannel   String?   // card, bank_transfer, etc
  paidAt           DateTime?

  status        OrderStatus @default(pending)
  total         Float
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  items         OrderItem[]

  // ── ADD THESE NEW FIELDS TO LINK THE RIDER ────────────────
  riderId       Int?        // Nullable because orders start with no rider
  rider         User?       @relation("RiderOrders", fields: [riderId], references: [id])
  payout        Float?      // The delivery fee amount paid out to the rider

  @@index([businessId])
  @@index([customerId])
  @@index([riderId])        // Fast lookups for recent deliveries
}

model OrderItem {
  id         Int       @id @default(autoincrement())
  orderId    Int
  order      Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId Int?
  menuItem   MenuItem? @relation(fields: [menuItemId], references: [id])
  name       String
  price      Float
  quantity   Int       @default(1)
  createdAt  DateTime  @default(now())

  @@index([orderId])
  @@index([menuItemId])
}

model Thread {
  id           String    @id @default(uuid())
  type         String    // 'support_ticket' | 'broadcast'
  subject      String
  status       String    @default("open") // 'open' | 'closed'
  participants User[]    @relation("ThreadParticipants")
  messages     Message[]
  lastMessage  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Message {
  id         String   @id @default(uuid())
  threadId   String
  thread     Thread   @relation(fields: [threadId], references: [id], onDelete: Cascade)
  senderId   Int
  sender     User     @relation("MessageSender", fields: [senderId], references: [id])
  senderRole String
  content    String
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())
  
  @@index([threadId])
  @@index([senderId])
}

model RiderProfile {
  id            Int      @id @default(autoincrement())
  userId        Int      @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicleType   String
  plateNumber   String?
  idDocumentUrl String
  isVerified    Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model ShiftLog {
  id          Int       @id @default(autoincrement())
  riderId     Int
  rider       User      @relation(fields: [riderId], references: [id], onDelete: Cascade)
  startTime   DateTime  @default(now())
  endTime     DateTime? // Nullable while they are currently online
  createdAt   DateTime  @default(now())

  @@index([riderId])
}

model Promo {
  id          Int      @id @default(autoincrement())
  businessId  Int
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  title       String   // e.g. "20% Off Jollof Fiesta"
  desc        String   // e.g. "Valid until 5PM today"
  bgGradient  String   @default("from-orange-500 to-red-500") // Tailwind gradient string
  isActive    Boolean  @default(true)
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  @@index([businessId])
}


